# Copy to .env for local development. EAS builds take these from eas.json.
# Only PUBLIC values: everything here ends up inside the APK.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://smart-chama10.vercel.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@smartchama.co.ke

# Optional feature switches (true/false)
# EXPO_PUBLIC_FEATURE_GROUP_CHAT=true
# EXPO_PUBLIC_FEATURE_MPESA_PAYMENTS=true
# EXPO_PUBLIC_FEATURE_APP_LOCK=true
# EXPO_PUBLIC_FEATURE_SECURE_SCREENS=true

# Development builds only: demo accounts on the sign-in screen
# EXPO_PUBLIC_FEATURE_DEMO_LOGIN=true
# EXPO_PUBLIC_DEMO_ADMIN_EMAIL=
# EXPO_PUBLIC_DEMO_ADMIN_PASSWORD=
# EXPO_PUBLIC_DEMO_MEMBER_EMAIL=
# EXPO_PUBLIC_DEMO_MEMBER_PASSWORD=
