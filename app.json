{
  "expo": {
    "name": "SmartChama",
    "slug": "smartchama",
    "owner": "chilly_reward1",
    "version": "1.0.0",
    "scheme": "smartchama",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.smartchama.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#22C55E"
      },
      "package": "co.ke.smartchama.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#22C55E"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "369d0cb4-c728-4a5d-8908-19bd3026c4aa"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/369d0cb4-c728-4a5d-8908-19bd3026c4aa"
    }
  }
}
